<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PathOfAvalonia.TreeApp.ViewModels"
             x:Class="PathOfAvalonia.TreeApp.BasicStatsSidebarView"
             x:DataType="vm:EquipmentViewModel"
             Background="#121217">
    <UserControl.Styles>
        <Style Selector="TextBlock.statGroupHeader">
            <Setter Property="Foreground" Value="#AEB8CB"/>
        </Style>
        <Style Selector="TextBlock.statGroupHeader.attributes">
            <Setter Property="Foreground" Value="#BDA0EA"/>
        </Style>
        <Style Selector="TextBlock.statGroupHeader.pools">
            <Setter Property="Foreground" Value="#E88787"/>
        </Style>
        <Style Selector="TextBlock.statGroupHeader.recovery">
            <Setter Property="Foreground" Value="#72C895"/>
        </Style>
        <Style Selector="TextBlock.statGroupHeader.defences">
            <Setter Property="Foreground" Value="#AFC2D5"/>
        </Style>
        <Style Selector="TextBlock.statGroupHeader.avoidance">
            <Setter Property="Foreground" Value="#C6A9E7"/>
        </Style>
        <Style Selector="TextBlock.statGroupHeader.resistances">
            <Setter Property="Foreground" Value="#E2B56F"/>
        </Style>

        <Style Selector="TextBlock.statValue">
            <Setter Property="Foreground" Value="#D5DAE4"/>
        </Style>
        <Style Selector="TextBlock.statValue.strength">
            <Setter Property="Foreground" Value="#ED7466"/>
        </Style>
        <Style Selector="TextBlock.statValue.dexterity">
            <Setter Property="Foreground" Value="#75D06F"/>
        </Style>
        <Style Selector="TextBlock.statValue.intelligence">
            <Setter Property="Foreground" Value="#7E9BEF"/>
        </Style>
        <Style Selector="TextBlock.statValue.life">
            <Setter Property="Foreground" Value="#EE7070"/>
        </Style>
        <Style Selector="TextBlock.statValue.mana">
            <Setter Property="Foreground" Value="#7F98F2"/>
        </Style>
        <Style Selector="TextBlock.statValue.energyShield">
            <Setter Property="Foreground" Value="#66D5E5"/>
        </Style>
        <Style Selector="TextBlock.statValue.armour">
            <Setter Property="Foreground" Value="#D8CBB4"/>
        </Style>
        <Style Selector="TextBlock.statValue.evasion">
            <Setter Property="Foreground" Value="#78C98A"/>
        </Style>
        <Style Selector="TextBlock.statValue.ward">
            <Setter Property="Foreground" Value="#D6B67B"/>
        </Style>
        <Style Selector="TextBlock.statValue.avoidance">
            <Setter Property="Foreground" Value="#D0B9EC"/>
        </Style>
        <Style Selector="TextBlock.statValue.fire">
            <Setter Property="Foreground" Value="#EE8456"/>
        </Style>
        <Style Selector="TextBlock.statValue.cold">
            <Setter Property="Foreground" Value="#67BFE8"/>
        </Style>
        <Style Selector="TextBlock.statValue.lightning">
            <Setter Property="Foreground" Value="#D8CF5B"/>
        </Style>
        <Style Selector="TextBlock.statValue.chaos">
            <Setter Property="Foreground" Value="#D66BDC"/>
        </Style>
    </UserControl.Styles>

    <Border BorderBrush="#343440" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,*">
            <StackPanel Margin="12,12,12,8" Spacing="8">
                <StackPanel>
                    <TextBlock Text="Basic stats"
                               Foreground="#F0F0F4"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Live tree and equipment totals"
                               Foreground="#8EA6D8"
                               FontSize="10"/>
                </StackPanel>
                <Grid ColumnDefinitions="Auto,100,*" ColumnSpacing="6">
                    <TextBlock Text="Level"
                               Foreground="#9999AA"
                               VerticalAlignment="Center"/>
                    <NumericUpDown Name="TreeCharacterLevelInput"
                                   Grid.Column="1"
                                   Minimum="1"
                                   Maximum="100"
                                   Increment="1"
                                   FormatString="0"
                                   Foreground="#EEEEF2"
                                   Value="{Binding CharacterLevel}"/>
                </Grid>
            </StackPanel>

            <Grid Name="PassivePreviewSlot"
                  Grid.Row="1"
                  Height="26"
                  Margin="8,0,8,7">
                <Border Name="PassivePreviewBox"
                        Padding="8,3"
                        Background="#342B18"
                        BorderBrush="#806A30"
                        BorderThickness="1"
                        CornerRadius="3"
                        IsVisible="{Binding HasPassivePreview}">
                    <TextBlock Text="{Binding PassivePreview.SidebarText}"
                               Foreground="#E7C86C"
                               FontSize="11"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="2"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding HasTreeCalculatedStats}">
                <StackPanel Margin="10,2,10,12" Spacing="8">
                    <ItemsControl Name="TreeCalculatedStatsList"
                                  ItemsSource="{Binding TreeCalculatedStats.StatGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:CalculatedStatGroupViewModel">
                                <StackPanel Margin="0,0,0,8" Spacing="3">
                                    <Grid ColumnDefinitions="Auto,*"
                                          ColumnSpacing="8"
                                          Margin="2,0,2,2">
                                        <TextBlock Text="{Binding Name}"
                                                   Classes="statGroupHeader"
                                                   Classes.attributes="{Binding IsAttributesGroup}"
                                                   Classes.pools="{Binding IsPoolsGroup}"
                                                   Classes.recovery="{Binding IsRecoveryGroup}"
                                                   Classes.defences="{Binding IsDefencesGroup}"
                                                   Classes.avoidance="{Binding IsAvoidanceGroup}"
                                                   Classes.resistances="{Binding IsResistancesGroup}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"/>
                                        <Border Grid.Column="1"
                                                Height="1"
                                                Margin="0,1,0,0"
                                                Background="#343440"
                                                VerticalAlignment="Center"/>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Stats}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:CalculatedStatMetricViewModel">
                                                <Border Margin="0,0,0,2"
                                                        Padding="7,3"
                                                        Background="#191920"
                                                        BorderBrush="#252530"
                                                        BorderThickness="1"
                                                        CornerRadius="3">
                                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" MinHeight="16">
                                                        <TextBlock Text="{Binding Label}"
                                                                   Foreground="#C2C2CD"
                                                                   FontSize="11"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Value}"
                                                                   Classes="statValue"
                                                                   Classes.strength="{Binding IsStrengthTone}"
                                                                   Classes.dexterity="{Binding IsDexterityTone}"
                                                                   Classes.intelligence="{Binding IsIntelligenceTone}"
                                                                   Classes.life="{Binding IsLifeTone}"
                                                                   Classes.mana="{Binding IsManaTone}"
                                                                   Classes.energyShield="{Binding IsEnergyShieldTone}"
                                                                   Classes.armour="{Binding IsArmourTone}"
                                                                   Classes.evasion="{Binding IsEvasionTone}"
                                                                   Classes.ward="{Binding IsWardTone}"
                                                                   Classes.avoidance="{Binding IsAvoidanceTone}"
                                                                   Classes.fire="{Binding IsFireTone}"
                                                                   Classes.cold="{Binding IsColdTone}"
                                                                   Classes.lightning="{Binding IsLightningTone}"
                                                                   Classes.chaos="{Binding IsChaosTone}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding DeltaText}"
                                                                   Foreground="#63D485"
                                                                   FontSize="10"
                                                                   VerticalAlignment="Center"
                                                                   IsVisible="{Binding IsPositiveChange}"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding DeltaText}"
                                                                   Foreground="#E56868"
                                                                   FontSize="10"
                                                                   VerticalAlignment="Center"
                                                                   IsVisible="{Binding IsNegativeChange}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Background="#30303A" Margin="0,2"/>
                    <TextBlock Text="{Binding TreeCalculatedStats.WarningText}"
                               Foreground="#B59062"
                               FontSize="9"
                               TextWrapping="Wrap"
                               IsVisible="{Binding TreeCalculatedStats.HasWarning}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
