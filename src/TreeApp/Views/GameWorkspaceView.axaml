<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PathOfAvalonia.TreeApp"
             xmlns:vm="clr-namespace:PathOfAvalonia.TreeApp.ViewModels"
             x:Class="PathOfAvalonia.TreeApp.Views.GameWorkspaceView"
             x:Name="Root"
             x:DataType="vm:GameWorkspaceViewModel">
    <Grid Background="#101018" RowDefinitions="48,*">
        <Border Background="#15151D" BorderBrush="#30303A" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="14,0" VerticalAlignment="Center">
                <TextBlock Text="PathOfAvalonia" Foreground="#F0F0F4" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding GameName}" Foreground="#CFCFE0" Margin="18,0,0,0" VerticalAlignment="Center"/>
                <Button Name="ChangeGameButton"
                        Grid.Column="3"
                        Content="Change Game"
                        Command="{Binding BackToLandingCommand}"/>
            </Grid>
        </Border>
        <TabControl Name="WorkspaceTabs" Grid.Row="1" Background="#101018">
            <TabItem Header="Passive Tree">
                <Grid Name="TreeRoot" Background="#101018" ColumnDefinitions="286,*" RowDefinitions="*,Auto">
                    <local:BasicStatsSidebarView Name="TreeStatsSidebar"
                                                 Grid.Column="0"
                                                 DataContext="{Binding State.Equipment}"/>
                    <Grid Name="TreeCanvas" Grid.Column="1">
                    </Grid>
                    <Border Name="PassiveTreeToolbar"
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Background="#15151D"
                            BorderBrush="#30303A"
                            BorderThickness="0,1,0,0"
                            Padding="12,8">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                            <WrapPanel Grid.Row="0" Orientation="Horizontal" ItemHeight="32">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6"
                                            Margin="0,0,12,0"
                                            DataContext="{Binding TreeSelection}"
                                            x:DataType="vm:TreeSelectionViewModel">
                                    <TextBlock Text="Class" Foreground="#9090A0" VerticalAlignment="Center"/>
                                    <ComboBox Name="ClassSelector" Width="130"
                                              ItemsSource="{Binding ClassNames}"
                                              SelectedIndex="{Binding SelectedClassIndex}"/>
                                    <TextBlock Text="Ascendancy" Foreground="#9090A0" VerticalAlignment="Center"/>
                                    <ComboBox Name="AscendancySelector" Width="150"
                                              ItemsSource="{Binding AscendancyNames}"
                                              SelectedItem="{Binding SelectedAscendancyName}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6"
                                            Margin="0,0,12,0"
                                            DataContext="{Binding ImportExport}"
                                            x:DataType="vm:BuildImportExportViewModel"
                                            IsVisible="{Binding HasPassiveTreeVariants}">
                                    <TextBlock Text="Passive tree" Foreground="#9090A0" VerticalAlignment="Center"/>
                                    <ComboBox Name="PassiveTreeVariantSelector"
                                              Width="180"
                                              ItemsSource="{Binding PassiveTreeVariantOptions}"
                                              SelectedIndex="{Binding SelectedPassiveTreeVariantIndex}"
                                              DisplayMemberBinding="{Binding DisplayName}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,8,0">
                                    <TextBlock Text="Search" Foreground="#9090A0" VerticalAlignment="Center"/>
                                    <TextBox Name="PassiveSearchInput"
                                             Width="220"
                                             Text="{Binding State.Tree.SearchText}"
                                             PlaceholderText="Search passives…"/>
                                    <Button Content="Clear"
                                            Command="{Binding State.Tree.ClearSearchCommand}"
                                            IsVisible="{Binding State.Tree.HasActiveSearch}"/>
                                    <TextBlock Text="{Binding State.Tree.SearchResultCount, StringFormat='{}{0} matches'}"
                                               Foreground="#F0594F"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding State.Tree.HasActiveSearch}"/>
                                </StackPanel>
                            </WrapPanel>
                            <WrapPanel Grid.Row="1" Orientation="Horizontal" ItemHeight="32">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,8,0">
                                <TextBlock Text="Tree" Foreground="#9090A0" VerticalAlignment="Center"
                                           IsVisible="{Binding HasTreeVersionOptions}"/>
                                <ComboBox Name="TreeVersionSelector"
                                          Width="98"
                                          ItemsSource="{Binding TreeVersionOptions}"
                                          SelectedItem="{Binding SelectedTreeVersion}"
                                          IsVisible="{Binding HasTreeVersionOptions}"/>
                                <TextBlock Text="Diff" Foreground="#9090A0" Margin="5,0,0,0" VerticalAlignment="Center"
                                           IsVisible="{Binding HasDiffVersionOptions}"/>
                                <ComboBox Name="DiffTreeVersionSelector"
                                          Width="98"
                                          ItemsSource="{Binding DiffTreeVersionOptions}"
                                          SelectedItem="{Binding SelectedDiffTreeVersion}"
                                          IsVisible="{Binding HasDiffVersionOptions}"/>
                                <Button Name="DiffLegendButton"
                                        Content="Legend"
                                        Padding="8,3"
                                        IsVisible="{Binding HasDiffVersionOptions}">
                                    <Button.Flyout>
                                        <Flyout>
                                            <Border Padding="10" Background="#1A1A24">
                                                <StackPanel Spacing="8">
                                                    <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="12" Height="12" Fill="#00F05A"/><TextBlock Text="Added" Foreground="#EAEAEA"/></StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="12" Height="12" Fill="#A85CFF"/><TextBlock Text="Changed" Foreground="#EAEAEA"/></StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="12" Height="12" Fill="#E55656"/><TextBlock Text="Removed" Foreground="#EAEAEA"/></StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <TextBlock Text="{Binding DiffSummary}" Foreground="#C6B36A" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Name="ImportFlyoutButton"
                                        Content="Import"
                                        DataContext="{Binding ImportExport}"
                                        x:DataType="vm:BuildImportExportViewModel">
                                    <Button.Flyout>
                                        <Flyout>
                                            <Border Width="360"
                                                    Padding="12"
                                                    Background="#1A1A24"
                                                    DataContext="{Binding DataContext.ImportExport, ElementName=Root}"
                                                    x:DataType="vm:BuildImportExportViewModel">
                                                <StackPanel Spacing="6">
                                <TextBlock Text="Import build" Foreground="#EAEAEA" FontWeight="Bold"
                                           IsVisible="{Binding IsImportSupported}"/>
                                <TextBlock Text="{Binding ImportPrompt}"
                                           Foreground="#AAAACC" FontSize="11"
                                           IsVisible="{Binding IsImportSupported}"/>
                                <TextBox Name="ImportInput"
                                         Text="{Binding ImportInput}"
                                         AcceptsReturn="False"
                                         TextWrapping="NoWrap"
                                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                         PlaceholderText="{Binding ImportPlaceholder}"
                                         IsVisible="{Binding IsImportSupported}">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Return" Command="{Binding ImportCommand}"/>
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsImportSupported}">
                                    <Button Name="ImportButton"
                                            Content="Import"
                                            Command="{Binding ImportCommand}"/>
                                    <Button Name="ClearButton"
                                            Content="Clear"
                                            Command="{Binding ClearCommand}"/>
                                    <Button Name="ImportBuildPlannerButton"
                                            Content="Import .build"
                                            Command="{Binding ImportBuildPlannerCommand}"
                                            IsVisible="{Binding SupportsBuildPlannerImport}"/>
                                    <Button Name="ExportBuildPlannerButton"
                                            Content="Export .build"
                                            Command="{Binding ExportBuildPlannerCommand}"
                                            IsVisible="{Binding SupportsBuildPlannerExport}"
                                            IsEnabled="{Binding CanExportBuildPlanner}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding UnsupportedImportStatus}"
                                           Foreground="#AAAACC"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding IsImportUnsupported}"/>
                                <TextBlock Name="ImportStatusText"
                                           Text="{Binding ImportStatus}"
                                           Foreground="{Binding ImportStatusForeground}"
                                           TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Name="EquipmentTab" Header="Equipment" IsEnabled="{Binding SupportsEquipment}">
                <local:EquipmentView DataContext="{Binding State.Equipment}"/>
            </TabItem>
            <TabItem Name="BuildOutputTab" Header="Calculations" IsEnabled="{Binding SupportsEquipment}">
                <Grid RowDefinitions="Auto,*" Background="#101018">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                Margin="14,12,14,4"
                                HorizontalAlignment="Left"
                                DataContext="{Binding State.Equipment}"
                                x:DataType="vm:EquipmentViewModel"
                                IsVisible="{Binding HasSkillSetVariants}">
                        <TextBlock Text="Skill set"
                                   Foreground="#EAEAEA"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <ComboBox Width="260"
                                  ItemsSource="{Binding SkillSetOptions}"
                                  SelectedIndex="{Binding SelectedSkillSetIndex}"
                                  DisplayMemberBinding="{Binding DisplayName}"/>
                    </StackPanel>
                    <local:BuildOutputView Grid.Row="1" DataContext="{Binding State.Equipment}"/>
                </Grid>
            </TabItem>
            <TabItem Name="AtlasTreeTab" Header="Atlas Tree" IsVisible="{Binding HasAtlasTree}">
                <Grid DataContext="{Binding Atlas}"
                      x:DataType="vm:AtlasTreeViewModel"
                      Background="#101018"
                      ColumnDefinitions="330,*"
                      RowDefinitions="*,Auto">
                    <Border Grid.Column="0"
                            Background="#15151D"
                            BorderBrush="#30303A"
                            BorderThickness="0,0,1,0"
                            Padding="14">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Text="Allocated Atlas modifiers"
                                               Foreground="#F0F0F4"
                                               FontWeight="Bold"
                                               FontSize="16"/>
                                    <TextBlock Text="{Binding PointUsage}"
                                               Foreground="{Binding PointUsageBrush}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Reset"
                                        Command="{Binding ResetCommand}"
                                        VerticalAlignment="Top"/>
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       Text="Repeated numeric effects are summed across allocated nodes."
                                       Foreground="#9090A0"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,8"/>
                            <Grid Grid.Row="2">
                                <TextBlock Text="Allocate nodes to see their combined effects."
                                           Foreground="#777787"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding !HasAggregatedStats}"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              IsVisible="{Binding HasAggregatedStats}">
                                    <ItemsControl ItemsSource="{Binding AggregatedStatGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AtlasAggregatedStatGroupViewModel">
                                                <StackPanel Margin="0,0,0,12">
                                                    <TextBlock Text="{Binding Type}"
                                                               Foreground="#C6B36A"
                                                               FontWeight="Bold"
                                                               Margin="2,4,2,3"/>
                                                    <ItemsControl ItemsSource="{Binding Stats}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:AtlasAggregatedStatItemViewModel">
                                                                <Border BorderBrush="#2B2B38"
                                                                        BorderThickness="0,0,0,1"
                                                                        Padding="2,7"
                                                                        Opacity="{Binding Opacity}">
                                                                    <TextBlock Text="{Binding Text}"
                                                                               Foreground="#8D98FF"
                                                                               TextWrapping="Wrap"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                    <Grid Name="AtlasCanvas" Grid.Column="1"/>
                    <Border Name="AtlasTreeToolbar"
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Background="#15151D"
                            BorderBrush="#30303A"
                            BorderThickness="0,1,0,0"
                            Padding="12,8">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                            <WrapPanel Grid.Row="0" Orientation="Horizontal" ItemHeight="32">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Search" Foreground="#9090A0" VerticalAlignment="Center"/>
                                    <TextBox Name="AtlasSearchInput"
                                             Width="260"
                                             Text="{Binding SearchText}"
                                             PlaceholderText="Search Atlas passives…"/>
                                    <Button Content="Clear"
                                            Command="{Binding ClearSearchCommand}"
                                            IsVisible="{Binding HasActiveSearch}"/>
                                    <TextBlock Text="{Binding SearchResultCount, StringFormat='{}{0} matches'}"
                                               Foreground="#F0594F"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding HasActiveSearch}"/>
                                </StackPanel>
                            </WrapPanel>
                            <WrapPanel Grid.Row="1" Orientation="Horizontal" ItemHeight="32">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="Atlas" Foreground="#9090A0" VerticalAlignment="Center"/>
                                <ComboBox Name="AtlasVersionSelector"
                                          Width="98"
                                          ItemsSource="{Binding VersionOptions}"
                                          SelectedItem="{Binding SelectedVersion}"/>
                                <TextBlock Text="Diff" Foreground="#9090A0" Margin="5,0,0,0" VerticalAlignment="Center"
                                           IsVisible="{Binding HasDiffVersionOptions}"/>
                                <ComboBox Name="AtlasDiffVersionSelector"
                                          Width="98"
                                          ItemsSource="{Binding DiffVersionOptions}"
                                          SelectedItem="{Binding SelectedDiffVersion}"
                                          IsVisible="{Binding HasDiffVersionOptions}"/>
                                <Button Name="AtlasDiffLegendButton"
                                        Content="Legend"
                                        Padding="8,3"
                                        IsVisible="{Binding HasDiffVersionOptions}">
                                    <Button.Flyout>
                                        <Flyout>
                                            <Border Padding="10" Background="#1A1A24">
                                                <StackPanel Spacing="8">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Ellipse Width="12" Height="12" Fill="#00F05A"/>
                                                        <TextBlock Text="Added" Foreground="#EAEAEA"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Ellipse Width="12" Height="12" Fill="#A85CFF"/>
                                                        <TextBlock Text="Changed" Foreground="#EAEAEA"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Ellipse Width="12" Height="12" Fill="#E55656"/>
                                                        <TextBlock Text="Removed" Foreground="#EAEAEA"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <TextBlock Text="{Binding DiffSummary}"
                                           Foreground="#C6B36A"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatusMessage}"
                                           Foreground="#E56868"
                                           VerticalAlignment="Center"
                                           MaxWidth="340"
                                           TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
